# === Database Configuration ===
# PostgreSQL connection string (e.g., Supabase)
SUPABASE_DB_URL="your_postgresql_url_here"

# === AI Service Configuration ===
# OpenAI API Key (Required for GPT-4o-mini)
OPENAI_API_KEY="your_openai_api_key_here"

# Hugging Face API Key (Optional: set to use Llama-3-8B via Hugging Face)
HUGGINGFACE_API_KEY=""

# === Server Configuration ===
# Default port is 3000
# Default port is 3000
PORT=3000

# === Backend CORS Configuration ===
# Comma-separated list of allowed origins (e.g., your Vercel URL)
ALLOWED_ORIGINS="http://localhost:5173"

# === Frontend Environment Variables ===
# The base URL of the backend API (used for production)
# For Vercel, this should be your Render backend URL
VITE_API_BASE_URL="http://localhost:3000"
